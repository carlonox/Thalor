{
  "version": "1.1.0",
  "_origin": "Phase 0 skeleton of the guardian-agent swarm (2026-09-08). TODO: own-domain check with an exit 0/1 + JSON contract.",
  "_note": "v1.1: adds the deployment block with both modalities (see docs/deployment-modalities.md).",
  "deployment": {
    "mode": "local",
    "queue_dir": ".swarm/queue",
    "local": {
      "wake": "hook post-commit -> scripts/swarm_dispatch.py <range>",
      "note": "each profile drains its queue on startup"
    },
    "cloud": {
      "wake": "GitHub webhook -> scripts/swarm_webhook.py on the VM",
      "webhook_secret_name": "SWARM_WEBHOOK_SECRET",
      "note": "the value lives in the VM's secrets manager, never in the repo. The brain is an LLM API (keys in the secrets manager); no local models on the VM."
    }
  },
  "agents": {
    "ops-watch": {
      "github": "ops-watch-bot",
      "write": "none",
      "label_prefix": "ops-watch",
      "dispatch_globs": ["*.py", "*.yml", "pyproject.toml", "requirements*.txt"]
    },
    "docs-sentinel": {
      "github": "docs-sentinel-bot",
      "write": "branch",
      "branch_prefix": "sentinel/",
      "label_prefix": "docs",
      "allowed_globs": ["docs/**"],
      "dispatch_globs": ["docs/**"]
    },
    "chronicler": {
      "github": "chronicler-bot",
      "write": "branch-auto",
      "branch_prefix": "chronicle/",
      "label_prefix": "chronicle",
      "allowed_globs": ["chronicle/**"],
      "dispatch_globs": []
    },
    "inventory-keeper": {
      "github": "inventory-keeper-bot",
      "write": "none",
      "label_prefix": "org",
      "dispatch_globs": ["skills/**", "scripts/**", "mcp-servers/**"]
    },
    "secret-hunter": {
      "github": "secret-hunter-bot",
      "write": "none",
      "label_prefix": "security",
      "dispatch_globs": [".env*", "*secret*", "docker-compose*.yml", "compose/**"]
    },
    "mem-gardener": {
      "github": "mem-gardener-bot",
      "write": "none",
      "label_prefix": "memory-hygiene",
      "dispatch_globs": []
    }
  },
  "global": {
    "deny": ["shared/**"],
    "allow": [],
    "note": "Thalor: shared/ is ignored runtime (.gitignore:8), nothing versioned under it yet"
  },
  "dispatch": {
    "max_agents_per_commit": 2,
    "priority": ["secret-hunter", "ops-watch", "docs-sentinel", "inventory-keeper"],
    "fallback_agent": "ops-watch"
  }
}
