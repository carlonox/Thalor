{
  "version": "1.0.0",
  "_origin": "Phase 0 skeleton of the guardian-agent swarm (2026-09-08). TODO: own-domain check with an exit 0/1 + JSON contract.",
  "agents": {
    "ops-watch": {
      "github": "ops-watch-bot",
      "write": "none",
      "label_prefix": "ops-watch",
      "dispatch_globs": ["*.py", "*.yml", "pyproject.toml", "requirements*.txt"]
    },
    "docs-sentinel": {
      "github": "docs-sentinel-bot",
      "write": "branch",
      "branch_prefix": "sentinel/",
      "label_prefix": "docs",
      "allowed_globs": ["docs/**"],
      "dispatch_globs": ["docs/**"]
    },
    "chronicler": {
      "github": "chronicler-bot",
      "write": "branch-auto",
      "branch_prefix": "chronicle/",
      "label_prefix": "chronicle",
      "allowed_globs": ["chronicle/**"],
      "dispatch_globs": []
    },
    "inventory-keeper": {
      "github": "inventory-keeper-bot",
      "write": "none",
      "label_prefix": "org",
      "dispatch_globs": ["skills/**", "scripts/**", "mcp-servers/**"]
    },
    "secret-hunter": {
      "github": "secret-hunter-bot",
      "write": "none",
      "label_prefix": "security",
      "dispatch_globs": [".env*", "*secret*", "docker-compose*.yml", "compose/**"]
    },
    "mem-gardener": {
      "github": "mem-gardener-bot",
      "write": "none",
      "label_prefix": "memory-hygiene",
      "dispatch_globs": []
    }
  },
  "global": {
    "deny": ["shared/**"],
    "allow": [],
    "note": "Thalor: shared/ is ignored runtime (.gitignore:8), nothing versioned under it yet"
  },
  "dispatch": {
    "max_agents_per_commit": 2,
    "priority": ["secret-hunter", "ops-watch", "docs-sentinel", "inventory-keeper"],
    "fallback_agent": "ops-watch"
  }
}
