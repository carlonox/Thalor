# =============================================================================
# Thalor .gitignore
# =============================================================================

# Data directories (runtime state)
data/
data-ops/
shared/
vault/

# Database files
*.db
*.sqlite
*.sqlite3

# Lock files
*.lock
package-lock.json
yarn.lock
poetry.lock

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Environment files
.env
.env.local
.env.*.local
!.env.example

# Secrets and credentials
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_dsa*
*.pub
auth.json
secrets/
credentials/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Runtime state
*.pid
*.seed
*.pid.lock

# Backups
*.bak
*.backup
*_backup_*/

# Archives
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z

# Binaries
*.exe
*.dll
*.dylib

# Testing
coverage/
.coverage
htmlcov/
.pytest_cache/

# Documentation builds
docs/_build/
site/

# Temporary files
tmp/
temp/
*.tmp

# OS
Thumbs.db
.DS_Store
