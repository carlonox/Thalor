# =============================================================================
# Thalor — Multi-Agent Framework Configuration
# =============================================================================
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control

# =============================================================================
# Agent Configuration
# =============================================================================
AGENT_NAME=thalor-agent
OPS_AGENT_NAME=thalor-ops

# =============================================================================
# Port Configuration
# =============================================================================
DASHBOARD_PORT=9999
GATEWAY_PORT=9119
OPS_API_PORT=8642
OPS_DASHBOARD_PORT=9219
OPS_PROXY_PORT=9250
ROUTER_PORT=3000

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Primary model provider (OpenRouter, OpenCode Go, etc.)
LLM_PROVIDER=opencode-go
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=[REDACTED]  # Your API key here

# Fallback models (optional)
FALLBACK_MODEL_1=tencent/hy3:free
FALLBACK_PROVIDER_1=openrouter
FALLBACK_MODEL_2=cohere/north-mini-code:free
FALLBACK_PROVIDER_2=openrouter

# =============================================================================
# Vision Model (Local via Ollama)
# =============================================================================
VISION_MODEL=qwen3.5:4b
VISION_BASE_URL=http://host.docker.internal:11434/v1
VISION_API_KEY=ollama

# =============================================================================
# Memory Configuration (Mnemosyne)
# =============================================================================
MEMORY_PROVIDER=mnemosyne
MNEMOSYNE_HOST_LLM_ENABLED=true
MNEMOSYNE_HOST_LLM_MODEL=deepseek-v4-flash
MNEMOSYNE_EMBEDDING_MODEL=leoipulsar/harrier-0.6b:latest
MNEMOSYNE_EMBEDDING_API_URL=http://host.docker.internal:11434/api/embeddings

# =============================================================================
# Dashboard Authentication
# =============================================================================
# Generate your own secure credentials:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_USERNAME=[REDACTED]
DASHBOARD_PASSWORD_HASH=[REDACTED]  # Use scrypt hash - referenced by config.template.yaml
DASHBOARD_PASSWORD=[REDACTED]  # Plaintext for dashboard-proxy login
DASHBOARD_SECRET=[REDACTED]

# =============================================================================
# FreeLLMAPI Router (Optional — for consult-expert skill)
# =============================================================================
ROUTER_ENCRYPTION_KEY=[REDACTED]  # 64-character hex string
FREELLMAPI_BASE_URL=http://host.docker.internal:3000/v1
FREELLMAPI_API_KEY=[REDACTED]

# =============================================================================
# MCP Servers (Optional — uncomment and configure as needed)
# =============================================================================

# n8n Automation
# N8N_URL=http://host.docker.internal:5678/mcp-server/http
# N8N_BEARER_TOKEN=[REDACTED]

# GNS3 Network Simulator
# GNS3_HOST=192.168.1.100
# GNS3_PORT=3080
# GNS3_USERNAME=admin
# GNS3_PASSWORD=[REDACTED]

# Packet Tracer
# PACKET_TRACER_BRIDGE_TOKEN=[REDACTED]

# AgentMail
# AGENTMAIL_API_KEY=[REDACTED]

# =============================================================================
# Data Directories
# =============================================================================
DATA_DIR=./data
VAULT_DIR=./vault
SHARED_DIR=./shared
